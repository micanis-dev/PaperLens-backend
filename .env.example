APP_ENV=development
APP_BASE_URL=http://127.0.0.1:8080
HTTP_ADDR=127.0.0.1:8080
DATABASE_URL=
FRONTEND_ORIGINS=http://127.0.0.1:5173
# Google OAuth (required for the real registration/login button)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://127.0.0.1:8080/v1/auth/google/callback
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_REDIRECT_URL=http://127.0.0.1:8080/v1/auth/apple/callback
APPLE_TEAM_ID=
APPLE_KEY_ID=
# PKCS8/SEC1 PEM; use a secret manager outside local development.
APPLE_PRIVATE_KEY=
APPLE_AUTH_URL=https://appleid.apple.com/auth/authorize
APPLE_TOKEN_URL=https://appleid.apple.com/auth/token
APPLE_JWKS_URL=https://appleid.apple.com/auth/keys
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=http://127.0.0.1:8080/v1/auth/github/callback
GITHUB_AUTH_URL=https://github.com/login/oauth/authorize
GITHUB_TOKEN_URL=https://github.com/login/oauth/access_token
GITHUB_USER_INFO_URL=https://api.github.com/user
GITHUB_EMAIL_URL=https://api.github.com/user/emails
# Development only: comma-separated id:label pairs. Never set this in production.
DEV_TEST_USERS=test-user-1:Test user 1,test-user-2:Test user 2,test-user-3:Test user 3,test-user-4:Test user 4
FRONTEND_BASE_URL=http://127.0.0.1:5173
MAGIC_LINK_BASE_URL=http://127.0.0.1:8080/v1/auth/magic-link/verify
# Comma-separated server-side user IDs allowed to publish rate policies.
ADMIN_USER_IDS=
